# Copy this file to .env and fill in real values.
# Never commit the real .env file to git.
# Database connection string (MongoDB Atlas or local MongoDB)
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.floaexc.mongodb.net/chartcoach?retryWrites=true&w=majority&appName=Cluster0
DATABASE_NAME=chartcoach
JWT_SECRET_KEY=change-this-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_ORIGIN=http://localhost:3000
# Set to true once the site runs over HTTPS in production
COOKIE_SECURE=false
