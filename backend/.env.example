# Copy this file to .env and fill in real values.
# Never commit the real .env file to git.

DATABASE_URL=mysql+pymysql://root:@localhost:3306/chartcoach
JWT_SECRET_KEY=change-this-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_ORIGIN=http://localhost:3000
# Set to true once the site runs over HTTPS in production
COOKIE_SECURE=false
